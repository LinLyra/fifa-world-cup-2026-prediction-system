# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → Secrets.
# Pick ONE analytics provider (or combine script + webhook).

# Plausible — privacy-friendly, simple dashboard (https://plausible.io)
# PLAUSIBLE_DOMAIN = "your-app.streamlit.app"

# Google Analytics 4
# GA_MEASUREMENT_ID = "G-XXXXXXXXXX"

# Optional: POST each new visitor session to your backend (Supabase Edge Function, n8n, etc.)
# VISIT_WEBHOOK_URL = "https://your-project.supabase.co/functions/v1/visit"

# Optional: append visits on your VPS (count lines: wc -l data/analytics/visits.jsonl)
# VISIT_LOG_FILE = "data/analytics/visits.jsonl"
